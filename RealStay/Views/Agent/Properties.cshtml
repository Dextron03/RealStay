@model List<Application.DTOs.Agent.AgentPropertyDto>
@{
    ViewData["Title"] = "Mantenimiento de Propiedades";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Propiedades</h2>
        <a asp-action="CreateProperty" class="btn btn-primary">Crear Nueva Propiedad</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Imagen</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Venta</th>
                        <th>Precio</th>
                        <th>Hab/Baños</th>
                        <th>Tamaño</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(property.FirstImage))
                                {
                                    <img src="@property.FirstImage" alt="@property.Name" style="width: 60px; height: 60px; object-fit: cover;" class="rounded">
                                }
                                else
                                {
                                    <div class="bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <span class="text-white">-</span>
                                    </div>
                                }
                            </td>
                            <td>@property.PropertyCode</td>
                            <td>@property.PropertyTypeName</td>
                            <td>@property.TypeSaleName</td>
                            <td>RD$ @property.Price.ToString("N0")</td>
                            <td>@property.NumberRooms / @property.NumberBaths</td>
                            <td>@property.Meters m²</td>
                            <td>
                                @if (property.Status == "Sold" || property.Status == "Vendida")
                                {
                                    <span class="badge bg-danger">Vendida</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditProperty" asp-route-id="@property.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="DeleteProperty" asp-route-id="@property.Id" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro que desea eliminar esta propiedad?');">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No tienes propiedades disponibles. Crea tu primera propiedad.
        </div>
    }
</div>