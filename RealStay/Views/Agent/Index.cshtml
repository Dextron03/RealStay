@model List<Application.DTOs.Agent.AgentPropertyDto>
@{
    ViewData["Title"] = "Home - Agente";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mis Propiedades</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var property in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card property-card">
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(property.FirstImage))
                            {
                                <img src="@property.FirstImage" class="card-img-top" alt="@property.Name" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <span class="text-white">Sin imagen</span>
                                </div>
                            }
                            @if (property.Status == "Sold" || property.Status == "Vendida")
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">Vendida</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@property.Name</h5>
                            <p class="card-text">
                                <strong>Código:</strong> @property.PropertyCode<br>
                                <strong>Tipo:</strong> @property.PropertyTypeName<br>
                                <strong>Venta:</strong> @property.TypeSaleName<br>
                                <strong>Precio:</strong> RD$ @property.Price.ToString("N0")<br>
                                <strong>Habitaciones:</strong> @property.NumberRooms | <strong>Baños:</strong> @property.NumberBaths<br>
                                <strong>Tamaño:</strong> @property.Meters m²
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No tienes propiedades registradas. Crea tu primera propiedad.
        </div>
    }
</div>

<style>
    .property-card {
        transition: transform 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .property-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }
</style>