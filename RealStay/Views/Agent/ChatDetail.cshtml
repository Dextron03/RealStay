@model List<Application.ViewModels.Messages.MessageViewModel>
@{
    ViewData["Title"] = "Conversación";
    Layout = "_Layout";
    var propertyId = ViewData["PropertyId"]?.ToString();
    var clientId   = ViewData["ClientId"]?.ToString();
    var agentId    = ViewData["AgentId"]?.ToString();
}

<div class="ag-root">
    <div class="ag-page-head">
        <a asp-action="Chats" class="ag-btn ag-btn-border">← Volver</a>
        <div class="ag-chat-subtitle">Chat con cliente</div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="ag-alert ag-alert-err">@TempData["Error"]</div>
    }

    <div class="ag-chat-layout">
        <div class="ag-chat-messages" id="chatBox">
            @if (!Model.Any())
            {
                <div class="ag-chat-empty">No hay mensajes aún.</div>
            }
            @foreach (var msg in Model)
            {
                var isMe = msg.SenderId == agentId;
                <div class="ag-msg-wrap @(isMe ? "ag-msg-wrap-me" : "")">
                    <div class="ag-msg @(isMe ? "ag-msg-me" : "ag-msg-other")">
                        <div>@msg.Content</div>
                        <span class="ag-msg-time">@msg.DateSend.ToString("dd/MM HH:mm")</span>
                    </div>
                </div>
            }
        </div>

        <div class="ag-chat-input-row">
            <form asp-action="SendMessage" method="post" style="display:flex;width:100%;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PropertyId" value="@propertyId" />
                <input type="hidden" name="ReceiverId" value="@clientId" />
                <input type="text" name="Content" class="ag-chat-input" placeholder="Escribe un mensaje..." required maxlength="250" />
                <button type="submit" class="ag-chat-send">Enviar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,300;0,400;1,300&family=DM+Sans:wght@@300;400;500&display=swap');
    .ag-root { font-family:'DM Sans',system-ui,sans-serif; background:#F7F5F2; padding:2rem 2.5rem; }
    .ag-page-head { display:flex; align-items:center; gap:1rem; margin-bottom:1.25rem; padding-bottom:1rem; border-bottom:0.5px solid #DDD9D2; }
    .ag-chat-subtitle { font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase; color:#9C9187; }
    .ag-alert { padding:0.75rem 1rem; font-size:0.8rem; border-left:2px solid; margin-bottom:1.25rem; }
    .ag-alert-err { background:#FCEBEB; border-color:#A32D2D; color:#791F1F; }
    .ag-btn { font-size:0.64rem; letter-spacing:0.14em; text-transform:uppercase; padding:0.55rem 1.1rem; border:none; border-radius:0; cursor:pointer; font-family:'DM Sans',system-ui,sans-serif; text-decoration:none; display:inline-block; transition:background 0.2s,color 0.2s,border-color 0.2s; }
    .ag-btn-border { background:transparent; color:#6B6560; border:0.5px solid #D4CFC8; } .ag-btn-border:hover { border-color:#9C7D4E; color:#9C7D4E; }
    .ag-chat-layout { display:flex; flex-direction:column; background:#fff; border:0.5px solid #DDD9D2; overflow:hidden; }
    .ag-chat-messages { height:440px; overflow-y:auto; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem; background:#FAFAF8; }
    .ag-chat-empty { text-align:center; color:#9C9187; font-size:0.82rem; margin:auto; }
    .ag-msg-wrap { display:flex; }
    .ag-msg-wrap-me { justify-content:flex-end; }
    .ag-msg { max-width:68%; padding:0.65rem 0.9rem; font-size:0.82rem; line-height:1.5; }
    .ag-msg-me    { background:#1C1A17; color:#F7F5F2; }
    .ag-msg-other { background:#fff; color:#1C1A17; border:0.5px solid #DDD9D2; }
    .ag-msg-time  { font-size:0.62rem; opacity:0.5; display:block; text-align:right; margin-top:4px; }
    .ag-chat-input-row { display:flex; border-top:0.5px solid #DDD9D2; }
    .ag-chat-input { flex:1; padding:0.85rem 1rem; border:none; background:#fff; font-family:'DM Sans',system-ui,sans-serif; font-size:0.85rem; color:#1C1A17; outline:none; }
    .ag-chat-send { padding:0.85rem 1.4rem; background:#1C1A17; color:#F7F5F2; border:none; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; cursor:pointer; font-family:'DM Sans',system-ui,sans-serif; transition:background 0.2s; }
    .ag-chat-send:hover { background:#9C7D4E; }
</style>
<script>
    const chatBox = document.getElementById('chatBox');
    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
</script>
}