@model Application.ViewModels.Agent.Properties.CreateAgentPropertyViewModel
@{
    ViewData["Title"] = "Crear Propiedad";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Crear Nueva Propiedad</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="CreateProperty" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="PropertyTypeId" class="form-label">Tipo de Propiedad *</label>
                    <select asp-for="PropertyTypeId" class="form-select" asp-items='new SelectList(ViewData["PropertyTypes"] as List<Application.DTOs.Administrator.Properties.PropertiesDto>, "Id", "TypeName")'>
                        <option value="">Seleccione un tipo</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="TypeSaleId" class="form-label">Tipo de Venta *</label>
                    <select asp-for="TypeSaleId" class="form-select" asp-items='new SelectList(ViewData["TypeSales"] as List<Application.DTOs.Administrator.Sales.SalesTypeDto>, "Id", "TypeName")'>
                        <option value="">Seleccione un tipo de venta</option>
                    </select>
                    <span asp-validation-for="TypeSaleId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Precio (RD$) *</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Ubicación *</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="NumberRooms" class="form-label">Habitaciones *</label>
                    <input asp-for="NumberRooms" class="form-control" type="number" />
                    <span asp-validation-for="NumberRooms" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="NumberBaths" class="form-label">Baños *</label>
                    <input asp-for="NumberBaths" class="form-control" type="number" />
                    <span asp-validation-for="NumberBaths" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="Meters" class="form-label">Tamaño (m²) *</label>
                    <input asp-for="Meters" class="form-control" type="number" />
                    <span asp-validation-for="Meters" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="ImprovementIds" class="form-label">Mejoras</label>
                    <select asp-for="ImprovementIds" class="form-select" multiple size="3">
                        @foreach (var improvement in ViewData["Improvements"] as List<Application.DTOs.Administrator.Improvements.ImprovementsDto>)
                        {
                            <option value="@improvement.Id">@improvement.ImprovementName</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Descripción *</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Images" class="form-label">Imágenes (1-4) *</label>
            <input asp-for="Images" class="form-control" type="file" multiple accept="image/*" />
            <span asp-validation-for="Images" class="text-danger"></span>
            <small class="text-muted">Seleccione entre 1 y 4 imágenes</small>
        </div>

        <div class="mt-4">
            <a asp-action="Properties" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-primary">Crear Propiedad</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}