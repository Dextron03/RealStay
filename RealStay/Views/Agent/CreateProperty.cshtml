@model Application.ViewModels.Agent.Properties.CreateAgentPropertyViewModel
@{
    ViewData["Title"] = "Crear Propiedad";
    Layout = "_Layout";
}

<div class="ag-root">
    <div class="ag-page-head">
        <div class="ag-page-title">Crear <em>propiedad</em></div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="ag-alert ag-alert-err">@TempData["Error"]</div>
    }

    <div class="ag-form-card">
        <form asp-action="CreateProperty" method="post" enctype="multipart/form-data">

            <div class="ag-section-tag">Clasificación</div>
            <div class="ag-form-row ag-mb">
                <div class="ag-field-group">
                    <label asp-for="PropertyTypeId" class="ag-label"></label>
                    <div class="ag-select-wrap">
                        <select asp-for="PropertyTypeId" class="ag-select"
                                asp-items='new SelectList(ViewData["PropertyTypes"] as List<Application.DTOs.Administrator.Properties.PropertiesDto>, "Id", "TypeName")'>
                            <option value="">Seleccione un tipo</option>
                        </select>
                    </div>
                    <span asp-validation-for="PropertyTypeId" class="ag-field-err"></span>
                </div>
                <div class="ag-field-group">
                    <label asp-for="TypeSaleId" class="ag-label"></label>
                    <div class="ag-select-wrap">
                        <select asp-for="TypeSaleId" class="ag-select"
                                asp-items='new SelectList(ViewData["TypeSales"] as List<Application.DTOs.Administrator.Sales.SalesTypeDto>, "Id", "TypeName")'>
                            <option value="">Seleccione un tipo</option>
                        </select>
                    </div>
                    <span asp-validation-for="TypeSaleId" class="ag-field-err"></span>
                </div>
            </div>

            <div class="ag-divider"></div>
            <div class="ag-section-tag">Detalles</div>
            <div class="ag-form-row ag-mb">
                <div class="ag-field-group">
                    <label asp-for="Price" class="ag-label">Precio (RD$)</label>
                    <input asp-for="Price" class="ag-input" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="ag-field-err"></span>
                </div>
                <div class="ag-field-group">
                    <label asp-for="Location" class="ag-label"></label>
                    <input asp-for="Location" class="ag-input" />
                    <span asp-validation-for="Location" class="ag-field-err"></span>
                </div>
            </div>
            <div class="ag-form-row-4 ag-mb">
                <div class="ag-field-group">
                    <label asp-for="NumberRooms" class="ag-label">Habitaciones</label>
                    <input asp-for="NumberRooms" class="ag-input" type="number" />
                    <span asp-validation-for="NumberRooms" class="ag-field-err"></span>
                </div>
                <div class="ag-field-group">
                    <label asp-for="NumberBaths" class="ag-label">Baños</label>
                    <input asp-for="NumberBaths" class="ag-input" type="number" />
                    <span asp-validation-for="NumberBaths" class="ag-field-err"></span>
                </div>
                <div class="ag-field-group">
                    <label asp-for="Meters" class="ag-label">m²</label>
                    <input asp-for="Meters" class="ag-input" type="number" />
                    <span asp-validation-for="Meters" class="ag-field-err"></span>
                </div>
                <div class="ag-field-group">
                    <label asp-for="ImprovementIds" class="ag-label">Mejoras</label>
                    <select asp-for="ImprovementIds" class="ag-select" multiple style="height:72px;">
                        @foreach (var imp in ViewData["Improvements"] as List<Application.DTOs.Administrator.Improvements.ImprovementsDto>)
                        {
                            <option value="@imp.Id">@imp.ImprovementName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="ag-field-group ag-mb">
                <label asp-for="Description" class="ag-label"></label>
                <textarea asp-for="Description" class="ag-textarea" rows="4"></textarea>
                <span asp-validation-for="Description" class="ag-field-err"></span>
            </div>

            <div class="ag-divider"></div>
            <div class="ag-section-tag">Imágenes (1–4)</div>
            <div class="ag-file-wrap ag-mb">
                <input asp-for="Images" type="file" multiple accept="image/*" />
                <div class="ag-file-display">Seleccionar imágenes</div>
            </div>
            <span asp-validation-for="Images" class="ag-field-err"></span>

            <div class="ag-divider"></div>
            <div class="ag-form-actions">
                <a asp-action="Properties" class="ag-btn ag-btn-border">Volver</a>
                <button type="submit" class="ag-btn ag-btn-dark">Crear propiedad</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        <script>
            document.querySelector('.ag-file-wrap input[type="file"]').addEventListener('change', function () {
                const display = this.closest('.ag-file-wrap').querySelector('.ag-file-display');
                if (this.files.length > 0) {
                    const names = Array.from(this.files).map(f => f.name).join(', ');
                    display.textContent = names;
                } else {
                    display.textContent = 'Seleccionar imágenes';
                }
            });
        </script>

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,300;0,400;1,300&family=DM+Sans:wght@@300;400;500&display=swap');

        .ag-root {
            font-family: 'DM Sans',system-ui,sans-serif;
            background: #F7F5F2;
            padding: 2rem 2.5rem;
        }

        .ag-page-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 0.5px solid #DDD9D2;
        }

        .ag-page-title {
            font-family: 'Cormorant Garamond',Georgia,serif;
            font-size: 1.6rem;
            font-weight: 300;
            color: #1C1A17;
        }

            .ag-page-title em {
                font-style: italic;
                color: #9C7D4E;
            }

        .ag-alert {
            padding: 0.75rem 1rem;
            font-size: 0.8rem;
            border-left: 2px solid;
            margin-bottom: 1.25rem;
        }

        .ag-alert-err {
            background: #FCEBEB;
            border-color: #A32D2D;
            color: #791F1F;
        }

        .ag-form-card {
            background: #fff;
            border: 0.5px solid #DDD9D2;
            padding: 1.75rem;
        }

        .ag-section-tag {
            font-size: 0.58rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: #9C7D4E;
            margin-bottom: 0.75rem;
        }

        .ag-label {
            font-size: 0.62rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #6B6560;
            display: block;
            margin-bottom: 0.45rem;
        }

        .ag-input, .ag-select, .ag-textarea {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 0.5px solid #D4CFC8;
            border-radius: 0;
            background: #FAFAF8;
            font-family: 'DM Sans',system-ui,sans-serif;
            font-size: 0.85rem;
            color: #1C1A17;
            outline: none;
            appearance: none;
            transition: border-color 0.2s;
        }

            .ag-input:focus, .ag-select:focus, .ag-textarea:focus {
                border-color: #9C7D4E;
                background: #fff;
            }

        .ag-select-wrap {
            position: relative;
        }

            .ag-select-wrap::after {
                content: '';
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                border: 4px solid transparent;
                border-top-color: #9C7D4E;
                pointer-events: none;
            }

        .ag-field-group {
            display: flex;
            flex-direction: column;
        }

        .ag-field-err {
            font-size: 0.72rem;
            color: #A32D2D;
            margin-top: 0.3rem;
        }

        .ag-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .ag-form-row-4 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 0.75rem;
        }

        .ag-mb {
            margin-bottom: 1rem;
        }

        .ag-divider {
            height: 0.5px;
            background: #E8E4DE;
            margin: 1.25rem 0;
        }

        .ag-file-wrap {
            position: relative;
        }

            .ag-file-wrap input[type="file"] {
                opacity: 0;
                position: absolute;
                inset: 0;
                cursor: pointer;
                z-index: 2;
                width: 100%;
            }

        .ag-file-display {
            padding: 0.65rem 0.85rem;
            border: 0.5px dashed #C4B99A;
            background: #FAFAF8;
            font-size: 0.8rem;
            color: #9C9187;
            cursor: pointer;
        }

        .ag-form-actions {
            display: flex;
            gap: 0.5rem;
        }

        .ag-btn {
            font-size: 0.64rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            padding: 0.65rem 1.3rem;
            border: none;
            border-radius: 0;
            cursor: pointer;
            font-family: 'DM Sans',system-ui,sans-serif;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s,color 0.2s,border-color 0.2s;
        }

        .ag-btn-dark {
            background: #1C1A17;
            color: #F7F5F2;
        }

            .ag-btn-dark:hover {
                background: #9C7D4E;
                color: #1C1A17;
            }

        .ag-btn-border {
            background: transparent;
            color: #6B6560;
            border: 0.5px solid #D4CFC8;
        }

            .ag-btn-border:hover {
                border-color: #9C7D4E;
                color: #9C7D4E;
            }

        @@media (max-width:640px) {
            .ag-form-row, .ag-form-row-4 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}