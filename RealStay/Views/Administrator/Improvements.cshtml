@model List<Application.DTOs.Administrator.Improvements.ImprovementsDto>
@{
    ViewData["Title"] = "Mejoras";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Mantenimiento de <em>mejoras</em></div>
        <a asp-action="CreateImprovement" class="adm-btn adm-btn-dark">Crear mejora</a>
    </div>
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead><tr><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var imp in Model)
                {
                    <tr>
                        <td>@imp.ImprovementName</td>
                        <td class="adm-muted">@imp.Description</td>
                        <td>
                            <div class="adm-actions">
                                <a asp-action="EditImprovement" asp-route-id="@imp.Id"
                                   class="adm-btn adm-btn-sm adm-btn-dark">Editar</a>
                                <a asp-action="DeleteImprovement" asp-route-id="@imp.Id"
                                   class="adm-btn adm-btn-sm adm-btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>