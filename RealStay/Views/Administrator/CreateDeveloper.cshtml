@model Application.ViewModels.Administrator.User.CreateUserViewModel
@{
    ViewData["Title"] = "Crear Desarrollador";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Crear <em>desarrollador</em></div>
    </div>

    <div class="adm-form-card">
        <form asp-action="CreateDeveloper" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="adm-validation"></div>

            <div class="adm-section-tag">Información personal</div>

            <div class="adm-form-row">
                <div class="adm-field">
                    <label asp-for="FirstName" class="adm-label"></label>
                    <input asp-for="FirstName" class="adm-input" />
                    <span asp-validation-for="FirstName" class="adm-field-err"></span>
                </div>

                <div class="adm-field">
                    <label asp-for="LastName" class="adm-label"></label>
                    <input asp-for="LastName" class="adm-input" />
                    <span asp-validation-for="LastName" class="adm-field-err"></span>
                </div>
            </div>

            <div class="adm-form-row">
                <div class="adm-field">
                    <label asp-for="UserName" class="adm-label"></label>
                    <input asp-for="UserName" class="adm-input" />
                    <span asp-validation-for="UserName" class="adm-field-err"></span>
                </div>

                <div class="adm-field">
                    <label asp-for="Cedula" class="adm-label"></label>
                    <input asp-for="Cedula" class="adm-input" />
                    <span asp-validation-for="Cedula" class="adm-field-err"></span>
                </div>
            </div>

            <div class="adm-field">
                <label asp-for="Email" class="adm-label"></label>
                <input asp-for="Email" class="adm-input" />
                <span asp-validation-for="Email" class="adm-field-err"></span>
            </div>

            <div class="adm-divider"></div>

            <div class="adm-section-tag">Acceso</div>

            <div class="adm-form-row">
                <div class="adm-field">
                    <label asp-for="Password" class="adm-label"></label>
                    <input asp-for="Password" type="password" class="adm-input" />
                    <span asp-validation-for="Password" class="adm-field-err"></span>
                </div>

                <div class="adm-field">
                    <label asp-for="ConfirmPassword" class="adm-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="adm-input" />
                    <span asp-validation-for="ConfirmPassword" class="adm-field-err"></span>
                </div>
            </div>

            <div class="adm-divider"></div>

            <div class="adm-form-actions">
                <a asp-action="Developers" class="adm-btn adm-btn-border">Volver</a>
                <button type="submit" class="adm-btn adm-btn-dark">Crear</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}