@model List<Application.ViewModels.Administrator.User.UserListViewModel>
@{
    ViewData["Title"] = "Administradores";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Mantenimiento de <em>administradores</em></div>
        <a asp-action="CreateAdmin" class="adm-btn adm-btn-dark">Crear administrador</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert-ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="adm-alert adm-alert-err">@TempData["Error"]</div>
    }

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr><th>Nombre</th><th>Apellido</th><th>Usuario</th><th>Cédula</th><th>Correo</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    <tr>
                        <td>@admin.FirstName</td>
                        <td>@admin.LastName</td>
                        <td class="adm-muted">@admin.UserName</td>
                        <td class="adm-muted">@admin.Cedula</td>
                        <td class="adm-muted">@admin.Email</td>
                        <td>
                            <div class="adm-actions">
                                <a asp-action="EditAdmin" asp-route-id="@admin.Id"
                                   class="adm-btn adm-btn-sm adm-btn-dark">Editar</a>
                                <a asp-action="ToggleAdminActive" asp-route-id="@admin.Id"
                                   class="adm-btn adm-btn-sm @(admin.IsActive ? "adm-btn-toggle-off" : "adm-btn-toggle-on")">
                                    @(admin.IsActive ? "Inactivar" : "Activar")
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>