@model Application.DTOs.Administrator.Dashboards.AdminDashboarDto
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Dashboard del <em>administrador</em></div>
    </div>
    <div class="adm-dash-grid">
        <div class="adm-dash-card avail">
            <div class="adm-dash-label">Propiedades disponibles</div>
            <div class="adm-dash-num">@Model.AvailableProperties</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card sold">
            <div class="adm-dash-label">Propiedades vendidas</div>
            <div class="adm-dash-num">@Model.SoldProperties</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card gold">
            <div class="adm-dash-label">Agentes activos</div>
            <div class="adm-dash-num">@Model.ActiveAgents</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card muted">
            <div class="adm-dash-label">Agentes inactivos</div>
            <div class="adm-dash-num">@Model.InactiveAgents</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card gold">
            <div class="adm-dash-label">Clientes activos</div>
            <div class="adm-dash-num">@Model.ActiveClients</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card muted">
            <div class="adm-dash-label">Clientes inactivos</div>
            <div class="adm-dash-num">@Model.InactiveClients</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card gold">
            <div class="adm-dash-label">Desarrolladores activos</div>
            <div class="adm-dash-num">@Model.ActiveDevelopers</div>
            <span class="adm-dash-accent"></span>
        </div>
        <div class="adm-dash-card muted">
            <div class="adm-dash-label">Desarrolladores inactivos</div>
            <div class="adm-dash-num">@Model.InactiveDevelopers</div>
            <span class="adm-dash-accent"></span>
        </div>
    </div>
</div>