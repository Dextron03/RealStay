@model List<Application.ViewModels.Administrator.Agent.AgentsListViewModel>
@{
    ViewData["Title"] = "Agentes";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Listado de <em>agentes</em></div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert adm-alert-ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="adm-alert adm-alert-err">@TempData["Error"]</div>
    }

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr><th>Nombre</th><th>Apellido</th><th>Correo</th><th>Propiedades</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var agent in Model)
                {
                    <tr>
                        <td>@agent.FirstName</td>
                        <td>@agent.LastName</td>
                        <td class="adm-muted">@agent.Email</td>
                        <td style="text-align:center;">@agent.QuantityProperties</td>
                        <td>
                            <div class="adm-actions">
                                <a asp-action="ToggleAgentActive" asp-route-id="@agent.Id"
                                   class="adm-btn adm-btn-sm @(agent.IsActive ? "adm-btn-toggle-off" : "adm-btn-toggle-on")">
                                    @(agent.IsActive ? "Inactivar" : "Activar")
                                </a>
                                <a asp-action="DeleteAgent" asp-route-id="@agent.Id"
                                   class="adm-btn adm-btn-sm adm-btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>