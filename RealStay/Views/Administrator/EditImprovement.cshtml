@model Application.ViewModels.Administrator.Improvements.EditImprovementsViewModel
@{
    ViewData["Title"] = "Editar Mejora";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm-root">
    <div class="adm-page-head">
        <div class="adm-page-title">Editar <em>mejora</em></div>
    </div>

    <div class="adm-form-card">
        <form asp-action="EditImprovement" asp-route-id="@ViewBag.ImprovementId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="adm-validation"></div>

            <div class="adm-field">
                <label asp-for="ImprovementName" class="adm-label"></label>
                <input asp-for="ImprovementName" class="adm-input" />
                <span asp-validation-for="ImprovementName" class="adm-field-err"></span>
            </div>

            <div class="adm-field">
                <label asp-for="Description" class="adm-label"></label>
                <textarea asp-for="Description" class="adm-textarea" rows="3"></textarea>
                <span asp-validation-for="Description" class="adm-field-err"></span>
            </div>

            <div class="adm-divider"></div>

            <div class="adm-form-actions">
                <a asp-action="Improvements" class="adm-btn adm-btn-border">Volver</a>
                <button type="submit" class="adm-btn adm-btn-dark">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}