<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealStay.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            background: #F7F5F2;
        }

        .navbar-brand {
            color: #1C1A17 !important;
            font-weight: bold;
        }

            .navbar-brand:hover {
                color: #9C7D4E !important;
            }

        .nav-link {
            color: #1C1A17 !important;
        }

            .nav-link:hover {
                color: #9C7D4E !important;
            }

        .btn-main {
            background-color: #1C1A17;
            color: #F7F5F2;
            border: none;
        }

            .btn-main:hover {
                background-color: #9C7D4E;
                color: #fff;
            }

        .btn-outline-custom {
            border: 1px solid #D4CFC8;
            color: #6B6560;
        }

            .btn-outline-custom:hover {
                background-color: #9C7D4E;
                color: #fff;
                border-color: #9C7D4E;
            }

        .fa-user-circle {
            color: #1C1A17 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-2"></i>RealStay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Agents">Agentes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Admins">Administradores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Developers">Desarrolladores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="PropertyTypes">Tipos de Propiedad</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="SaleTypes">Tipos de Venta</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Improvements">Mejoras</a>
                                </li>
                            }
                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Agents">Agentes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="MyProperties">Mis Favoritos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="MyOffers">Mis Ofertas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="Chats">Mensajes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="Profile">Perfil</a>
                                </li>
                            }
                            @if (User.IsInRole("Agent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Index">Home Agente</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Properties">Mis Propiedades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Chats">Mensajes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Offers">Ofertas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Profile">Perfil</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                                    <span class="me-2 text-dark">@User.Identity.Name</span>
                                    <i class="fas fa-user-circle fa-lg"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Cerrar Sesión</button>
                                    </form>
                                    <li><hr class="dropdown-divider"></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-custom btn-sm px-3 me-2" asp-controller="Home" asp-action="Agents">Listado de agentes</a>
                            <a class="btn btn-outline-custom btn-sm me-2 px-3" asp-controller="Account" asp-action="Index">Iniciar Sesión</a>
                            <a class="btn btn-main btn-sm px-3 shadow-sm" asp-controller="Account" asp-action="Register">Únete a la app</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted"></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>