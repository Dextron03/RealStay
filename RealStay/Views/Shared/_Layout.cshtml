<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealStay.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Account" asp-action="Index">RealStay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Agents">Listado de Agentes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Admins">Mantenimiento Administradores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Developers">Mantenimiento Desarrolladores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="PropertyTypes">Mantenimiento Tipo de Propiedades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="SaleTypes">Mantenimiento Tipo de Ventas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Administrator" asp-action="Improvements">Mantenimiento de Mejoras</a>
                                </li>
                            }
                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="MyProperties">Mis Favoritos</a>
                                </li>
                            }
                            @if (User.IsInRole("Agent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Index">Home del Agente</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Properties">Mantenimiento de Propiedades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Profile">Mi Perfil</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Agents">Agentes</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="me-3">Hola, @User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm me-2" asp-controller="Account" asp-action="Index">Iniciar Sesión</a>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Index">Únete a la app</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RealStay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
