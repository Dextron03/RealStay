@model List<Application.ViewModels.Properties.PropertyViewModel>
@{
    ViewData["Title"] = "Propiedades de " + ViewData["AgentName"];
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-primary">Propiedades de @ViewData["AgentName"]</h2>
            <p class="text-muted">Explora el portafolio exclusivo de este agente.</p>
            <a asp-action="Agents" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Volver a agentes</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@(item.ImageUrls.Any() ? item.ImageUrls.First() : "/img/no-image.jpg")"
                             class="card-img-top"
                             style="height: 200px; object-fit: cover;" alt="@item.Name">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            <h6 class="text-primary fw-bold">RD$ @item.Price.ToString("N0")</h6>
                            <p class="card-text text-muted small">@item.Location</p>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <a asp-action="PropertyDetails" asp-route-id="@item.Id" class="btn btn-primary w-100">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-home fa-3x text-muted mb-3"></i>
                <h3>Este agente no tiene propiedades</h3>
                <p class="text-muted">Vuelve más tarde para ver nuevas ofertas.</p>
            </div>
        }
    </div>
</div>