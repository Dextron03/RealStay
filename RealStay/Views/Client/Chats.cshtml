@model List<Application.ViewModels.Messages.ChatViewModel>
@{
ViewData["Title"] = "Mis Conversaciones";
    Layout = "_Layout";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:300;400&family=DM+Sans:300;400;500&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'DM Sans', sans-serif;
        background: #F7F5F2;
    }

    h2 {
        font-family: 'Cormorant Garamond', serif;
        color: #1C1A17;
    }

    .chat-item {
        background: #fff;
        border: 1px solid #DDD9D2;
        transition: all 0.2s ease;
    }

    .chat-item:hover {
        background: #FAFAF8;
    }

    .chat-title {
        font-weight: 500;
        color: #1C1A17;
    }

    .chat-message {
        font-size: 0.85rem;
        color: #9C9187;
    }

    .chat-date {
        font-size: 0.75rem;
        color: #9C9187;
    }

    .empty-state {
        color: #9C9187;
    }

    .btn-link-custom {
        color: #9C7D4E;
        text-decoration: none;
    }

    .btn-link-custom:hover {
        text-decoration: underline;
    }
</style>

</head>

<body>

<div class="container py-5">

<h2 class="mb-4">Mis Conversaciones</h2>

@if (Model.Any())
{
    <div class="d-flex flex-column gap-2">

        @foreach (var chat in Model)
        {
            var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var agentId = chat.SenderId == currentUserId ? chat.ReceiverId : chat.SenderId;

            <a asp-action="ChatDetail"
               asp-route-propertyId="@chat.PropertyId"
               asp-route-agentId="@agentId"
               class="chat-item d-flex justify-content-between align-items-start p-3 text-decoration-none">

                <div>
                    <div class="chat-title">Propiedad: @chat.PropertyId</div>
                    <div class="chat-message">@chat.LastMessage</div>
                </div>

                <div class="chat-date text-end">
                    @chat.DateLastMessage.ToString("dd/MM/yyyy HH:mm")
                </div>

            </a>
        }

    </div>
}
else
{
    <div class="text-center py-5 empty-state">
        <div style="font-size:2rem;">💬</div>
        <h4 class="mt-3">No tienes conversaciones</h4>
        <p>
            <a asp-action="Index" class="btn-link-custom">Explorar propiedades</a>
        </p>
    </div>
}

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
