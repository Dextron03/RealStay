@model Application.ViewModels.Properties.PropertyViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Volver al listado</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        {{-- Galería --}}
        <div class="col-md-7">
            @if (Model.ImageUrls.Any())
            {
                <div id="propertyCarousel" class="carousel slide shadow-sm rounded" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.ImageUrls[i]" class="d-block w-100" style="height:360px;object-fit:cover;" alt="Imagen @(i+1)">
                            </div>
                        }
                    </div>
                    @if (Model.ImageUrls.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height:360px;">
                    <span class="text-white fs-5">Sin imágenes</span>
                </div>
            }

            {{-- Descripción --}}
            <div class="card mt-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Descripción</h5>
                    <p class="card-text">@Model.Description</p>
                </div>
            </div>

            {{-- Mejoras --}}
            @if (Model.ImprovementNames.Any())
            {
                <div class="card mt-3 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Mejoras</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var imp in Model.ImprovementNames)
                            {
                                <span class="badge bg-success">@imp</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        {{-- Info + Acciones --}}
        <div class="col-md-5">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="card-title">@Model.Name</h3>
                    <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @Model.Location</p>
                    <hr>
                    <p>
                        <span class="badge bg-info text-dark me-1">@Model.PropertyTypeName</span>
                        <span class="badge bg-secondary">@Model.TypeSaleName</span>
                    </p>
                    <h4 class="text-primary">RD$ @Model.Price.ToString("N0")</h4>
                    <ul class="list-unstyled mt-2">
                        <li><strong>Habitaciones:</strong> @Model.Rooms</li>
                        <li><strong>Baños:</strong> @Model.Bathrooms</li>
                        <li><strong>Tamaño:</strong> @Model.Meters m²</li>
                        <li><strong>Código:</strong> @Model.Code</li>
                    </ul>
                    @if (!string.IsNullOrEmpty(Model.AgentName))
                    {
                        <hr>
                        <p class="mb-0"><strong>Agente:</strong> @Model.AgentName</p>
                        <p><strong>Teléfono:</strong> @Model.AgentPhone</p>
                    }
                </div>
            </div>

            {{-- Agregar/quitar favorito --}}
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="card-title">Favoritos</h6>
                    <form asp-action="AddToWishList" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm me-2">
                            ♥ Agregar a Favoritos
                        </button>
                    </form>
                    <form asp-action="RemoveFromWishList" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@Model.Id" />
                        <input type="hidden" name="returnTo" value="Details" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            Quitar de Favoritos
                        </button>
                    </form>
                </div>
            </div>

            {{-- Hacer oferta --}}
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="card-title">Hacer una Oferta</h6>
                    <form asp-action="MakeOffer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PropertyId" value="@Model.Id" />
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" name="OfferAmount" class="form-control" min="1" placeholder="Monto" required />
                            <button type="submit" class="btn btn-primary">Enviar</button>
                        </div>
                    </form>
                </div>
            </div>

            {{-- Contactar agente --}}
            @if (!string.IsNullOrEmpty(Model.AgentName))
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Contactar al Agente</h6>
                        <a asp-action="ChatDetail"
                           asp-route-propertyId="@Model.Id"
                           asp-route-agentId="@Model.AgentId"
                           class="btn btn-outline-primary btn-sm w-100">
                            Abrir Chat
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
