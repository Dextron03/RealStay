@model List<Application.ViewModels.Messages.MessageViewModel>
@{
ViewData["Title"] = "Conversación";
    Layout = "_Layout";
var propertyId = ViewData["PropertyId"]?.ToString();
var agentId = ViewData["AgentId"]?.ToString();
var clientId = ViewData["ClientId"]?.ToString();
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:300;400&family=DM+Sans:300;400;500&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'DM Sans', sans-serif;
        background: #F7F5F2;
    }

    h5 {
        font-family: 'Cormorant Garamond', serif;
        color: #1C1A17;
    }

    .btn-back {
        border: 1px solid #D4CFC8;
        color: #6B6560;
    }

    .btn-back:hover {
        background: #9C7D4E;
        color: white;
    }

    .card-custom {
        border: 1px solid #DDD9D2;
        background: #fff;
    }

    .chat-box {
        height: 420px;
        overflow-y: auto;
        background: #FAFAF8;
    }

    .message-me {
        background: #1C1A17;
        color: #F7F5F2;
    }

    .message-other {
        background: #fff;
        border: 1px solid #D4CFC8;
    }

    .input-custom {
        border: 1px solid #D4CFC8;
        background: #FAFAF8;
    }

    .input-custom:focus {
        border-color: #9C7D4E;
        box-shadow: none;
    }

    .btn-send {
        background: #1C1A17;
        color: #F7F5F2;
        border: none;
    }

    .btn-send:hover {
        background: #9C7D4E;
    }

    .alert-error {
        background: #FCEBEB;
        border-left: 3px solid #A32D2D;
        color: #791F1F;
    }

    .empty {
        color: #9C9187;
    }
</style>

</head>

<body>

<div class="container py-5">

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Chats" class="btn btn-sm btn-back">← Volver</a>
    <h5 class="mb-0">Chat con Agente</h5>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-error alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card-custom">

    <div class="p-3 chat-box" id="chatBox">

        @if (!Model.Any())
        {
            <p class="text-center mt-4 empty">No hay mensajes aún</p>
        }

        @foreach (var msg in Model)
        {
            var isMe = msg.SenderId == clientId;

            <div class="d-flex @(isMe ? "justify-content-end" : "justify-content-start") mb-2">
                <div class="px-3 py-2 rounded-2 @(isMe ? "message-me" : "message-other")"
                     style="max-width:70%;">

                    <div>@msg.Content</div>

                    <small class="d-block text-end @(isMe ? "text-white-50" : "text-muted")" style="font-size:.72rem;">
                        @msg.DateSend.ToString("dd/MM HH:mm")
                    </small>

                </div>
            </div>
        }

    </div>

    <div class="p-3 border-top">

        <form asp-action="SendMessage" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="PropertyId" value="@propertyId" />
            <input type="hidden" name="ReceiverId" value="@agentId" />

            <div class="input-group">
                <input type="text"
                       name="Content"
                       class="form-control input-custom"
                       placeholder="Escribe un mensaje..."
                       maxlength="250"
                       required />

                <button class="btn btn-send">Enviar</button>
            </div>

        </form>

    </div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const chatBox = document.getElementById('chatBox');
    chatBox.scrollTop = chatBox.scrollHeight;
</script>

</body>
</html>
