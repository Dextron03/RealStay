@model List<Application.ViewModels.Properties.PropertyViewModel>
@using Application.ViewModels.Properties
@{
    ViewData["Title"] = "Propiedades Disponibles";
    Layout = "_Layout";
    var filters = ViewData["Filters"] as PropertyFilterViewModel ?? new PropertyFilterViewModel();
}

<div class="container mt-4">
    <h2 class="mb-4">Propiedades Disponibles</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    {{-- Filtros --}}
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Tipo de Venta</label>
                    <select name="TypeSaleName" class="form-select">
                        <option value="">Todos</option>
                        <option value="Venta" selected="@(filters.TypeSaleName == "Venta")">Venta</option>
                        <option value="Alquiler" selected="@(filters.TypeSaleName == "Alquiler")">Alquiler</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Habitaciones</label>
                    <input type="number" name="Rooms" class="form-control" min="1" value="@filters.Rooms" placeholder="Ej: 3" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Baños</label>
                    <input type="number" name="Bathrooms" class="form-control" min="1" value="@filters.Bathrooms" placeholder="Ej: 2" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card property-card h-100">
                        @if (p.ImageUrls.Any())
                        {
                            <img src="@p.ImageUrls.First()" class="card-img-top" alt="@p.Name" style="height:200px;object-fit:cover;">
                        }
                        else
                        {
                            <div class="bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                                <span class="text-white">Sin imagen</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text text-muted small mb-1">@p.Location</p>
                            <p class="card-text">
                                <span class="badge bg-info text-dark me-1">@p.PropertyTypeName</span>
                                <span class="badge bg-secondary">@p.TypeSaleName</span>
                                <span class="badge @(p.Status == "Available" ? "bg-success" : "bg-danger")">
                                    @(p.Status == "Available" ? "Disponible" : "No disponible")
                                </span>
                            </p>
                            <p class="card-text">
                                <strong>RD$ @p.Price.ToString("N0")</strong><br>
                                <small>@p.Rooms hab. · @p.Bathrooms baños · @p.Meters m²</small>
                            </p>
                            <div class="mt-auto">
                                <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-primary btn-sm w-100">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay propiedades disponibles con los filtros seleccionados.</div>
    }
</div>

<style>
    .property-card { transition: transform 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .property-card:hover { transform: translateY(-5px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
</style>
