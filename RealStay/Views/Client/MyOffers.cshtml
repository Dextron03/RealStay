@model List<Application.ViewModels.Offers.OfferViewModel>
@{
ViewData["Title"] = "Mis Ofertas";
    Layout = "_Layout";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:300;400&family=DM+Sans:300;400;500&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'DM Sans', sans-serif;
        background: #F7F5F2;
    }

    h2 {
        font-family: 'Cormorant Garamond', serif;
        color: #1C1A17;
    }

    .table {
        background: #fff;
        border: 1px solid #DDD9D2;
    }

    .table thead {
        background: #1C1A17;
        color: #F7F5F2;
    }

    .table tbody tr:hover {
        background: #FAFAF8;
    }

    .badge-success-custom {
        background: #4A7C59;
    }

    .badge-danger-custom {
        background: #A32D2D;
    }

    .badge-warning-custom {
        background: #E8D8A9;
        color: #1C1A17;
    }

    .btn-outline-custom {
        border: 1px solid #D4CFC8;
        color: #6B6560;
    }

    .btn-outline-custom:hover {
        background: #9C7D4E;
        color: white;
        border-color: #9C7D4E;
    }

    .empty-state {
        color: #9C9187;
    }
</style>

</head>

<body>

<div class="container py-5">

<h2 class="mb-4">Mis Ofertas</h2>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Propiedad</th>
                    <th>Monto Ofertado</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var offer in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="PropertyDetails" asp-route-id="@offer.PropertyId" class="text-decoration-none">
                                Ver propiedad
                            </a>
                        </td>

                        <td>RD$ @offer.OfferAmount.ToString("N0")</td>

                        <td>
                            @{
                                var badgeClass = offer.Status switch
                                {
                                    "Accepted" => "badge-success-custom",
                                    "Rejected" => "badge-danger-custom",
                                    _ => "badge-warning-custom"
                                };

                                var statusLabel = offer.Status switch
                                {
                                    "Accepted" => "Aceptada",
                                    "Rejected" => "Rechazada",
                                    _ => "Pendiente"
                                };
                            }

                            <span class="badge @badgeClass">@statusLabel</span>
                        </td>

                        <td>
                            <a asp-action="PropertyDetails"
                               asp-route-id="@offer.PropertyId"
                               class="btn btn-sm btn-outline-custom">
                                Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}
else
{
    <div class="text-center py-5 empty-state">
        <div style="font-size:2rem;">💰</div>
        <h4 class="mt-3">No has realizado ninguna oferta</h4>
        <p>
            <a asp-action="Index">Explorar propiedades</a>
        </p>
    </div>
}

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
