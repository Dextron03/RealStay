@model List<Application.ViewModels.Properties.PropertyViewModel>
@{
    ViewData["Title"] = "Mis Favoritos";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4">Mis Favoritos</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card property-card h-100">
                        @if (p.ImageUrls.Any())
                        {
                            <img src="@p.ImageUrls.First()" class="card-img-top" alt="@p.Name" style="height:200px;object-fit:cover;">
                        }
                        else
                        {
                            <div class="bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                                <span class="text-white">Sin imagen</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text text-muted small mb-1">@p.Location</p>
                            <p class="card-text">
                                <span class="badge bg-info text-dark me-1">@p.PropertyTypeName</span>
                                <span class="badge bg-secondary">@p.TypeSaleName</span>
                            </p>
                            <p class="card-text">
                                <strong>RD$ @p.Price.ToString("N0")</strong><br>
                                <small>@p.Rooms hab. · @p.Bathrooms baños · @p.Meters m²</small>
                            </p>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-primary btn-sm flex-grow-1">
                                    Ver Detalles
                                </a>
                                <form asp-action="RemoveFromWishList" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@p.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar de favoritos">♥</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No tienes propiedades en favoritos.
            <a asp-action="Index" class="alert-link">Explorar propiedades</a>
        </div>
    }
</div>

<style>
    .property-card { transition: transform 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .property-card:hover { transform: translateY(-5px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
</style>
