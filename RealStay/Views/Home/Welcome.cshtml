@{
    ViewData["Title"] = "Bienvenido";
    Layout = "_LandingLayout";
}

<section class="ls-hero">
    <div class="ls-hero-grid"></div>
    <div class="ls-hero-ring"></div>
    <div class="ls-hero-inner">
        <div class="ls-eyebrow">Bienvenido a</div>
        <h1 class="ls-hero-title">Real<em>Stay</em></h1>
        <p class="ls-hero-sub">
            Encuentra la propiedad ideal para comprar o alquilar.<br />
            Simple, seguro y sin complicaciones.
        </p>
        <div class="ls-hero-actions">
            <a asp-controller="Home" asp-action="Index" class="ls-btn-gold">Ver propiedades</a>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="ls-btn-outline">Crear cuenta</a>
            }
        </div>
    </div>
</section>

<div class="ls-stats">
    <div class="ls-stat">
        <div class="ls-stat-num">@(ViewBag.TotalProperties ?? "—")</div>
        <div class="ls-stat-label">Propiedades</div>
        <span class="ls-stat-accent"></span>
    </div>
    <div class="ls-stat">
        <div class="ls-stat-num">@(ViewBag.TotalAgents ?? "—")</div>
        <div class="ls-stat-label">Agentes</div>
        <span class="ls-stat-accent"></span>
    </div>
    <div class="ls-stat">
        <div class="ls-stat-num">@(ViewBag.TotalSold ?? "—")</div>
        <div class="ls-stat-label">Vendidas</div>
        <span class="ls-stat-accent"></span>
    </div>
    <div class="ls-stat">
        <div class="ls-stat-num">@(ViewBag.TotalClients ?? "—")</div>
        <div class="ls-stat-label">Clientes</div>
        <span class="ls-stat-accent"></span>
    </div>
</div>

<section class="ls-services">
    <div class="ls-section-head">
        <div class="ls-section-tag">Servicios</div>
        <div class="ls-section-title">¿Qué puedes hacer en <em>RealStay</em>?</div>
        <div class="ls-section-sub">Todo lo que necesitas para comprar, vender o alquilar.</div>
    </div>
    <div class="ls-cards">
        <div class="ls-card">
            <div class="ls-card-num">01</div>
            <div class="ls-card-title">Busca tu propiedad</div>
            <p class="ls-card-text">Filtra por tipo, precio, habitaciones y más para encontrar exactamente lo que buscas.</p>
        </div>
        <div class="ls-card">
            <div class="ls-card-num">02</div>
            <div class="ls-card-title">Haz una oferta</div>
            <p class="ls-card-text">Envía tu oferta directamente al agente y negocia el mejor precio desde la plataforma.</p>
        </div>
        <div class="ls-card">
            <div class="ls-card-num">03</div>
            <div class="ls-card-title">Contacta al agente</div>
            <p class="ls-card-text">Chatea con el agente responsable y resuelve tus dudas al instante.</p>
        </div>
    </div>
</section>

<section class="ls-steps">
    <div class="ls-section-head">
        <div class="ls-section-tag" style="color:#9C7D4E;">Proceso</div>
        <div class="ls-section-title" style="color:#F7F5F2;">¿Cómo <em style="color:#C4985E;">funciona</em>?</div>
        <div class="ls-section-sub">Tres pasos simples para encontrar tu próximo hogar.</div>
    </div>
    <div class="ls-steps-grid">
        <div class="ls-step">
            <div class="ls-step-circle">1</div>
            <div class="ls-step-title">Crea tu cuenta</div>
            <p class="ls-step-text">Regístrate como cliente en menos de un minuto y accede a todas las funciones.</p>
        </div>
        <div class="ls-step">
            <div class="ls-step-circle">2</div>
            <div class="ls-step-title">Explora propiedades</div>
            <p class="ls-step-text">Navega el catálogo completo, filtra por preferencias y guarda tus favoritas.</p>
        </div>
        <div class="ls-step">
            <div class="ls-step-circle">3</div>
            <div class="ls-step-title">Conecta y negocia</div>
            <p class="ls-step-text">Envía una oferta o chatea con el agente y cierra el trato sin salir de la plataforma.</p>
        </div>
    </div>
</section>

<section class="ls-cta">
    <div class="ls-cta-title">¿Listo para encontrar tu <em>propiedad ideal</em>?</div>
    <div class="ls-cta-sub">Únete a cientos de clientes que ya confían en RealStay.</div>
    <div class="ls-cta-actions">
        @if (!User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Register" class="ls-btn-dark">Comenzar ahora</a>
            <a asp-controller="Account" asp-action="Index" class="ls-btn-border">Iniciar sesión</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="ls-btn-dark">Ver propiedades</a>
        }
    </div>
</section>

@section Scripts {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,300;0,400;1,300&family=DM+Sans:wght@@300;400;500&display=swap');

    *, *::before, *::after { box-sizing: border-box; }

    body { font-family: 'DM Sans', system-ui, sans-serif; background: #F7F5F2; }

    .ls-hero {
        background: #1C1A17;
        padding: 6rem 2rem 5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .ls-hero-grid {
        position: absolute; inset: 0;
        background-image:
            linear-gradient(rgba(184,149,90,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(184,149,90,0.05) 1px, transparent 1px);
        background-size: 52px 52px;
    }
    .ls-hero-ring {
        position: absolute;
        right: -80px; top: 50%; transform: translateY(-50%);
        width: 500px; height: 500px;
        border: 0.5px solid rgba(184,149,90,0.12);
        border-radius: 50%;
    }
    .ls-hero-ring::before {
        content: ''; position: absolute; inset: 50px;
        border: 0.5px solid rgba(184,149,90,0.07);
        border-radius: 50%;
    }
    .ls-hero-inner { position: relative; z-index: 2; }

    .ls-eyebrow {
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #9C7D4E;
        margin-bottom: 1.2rem;
        display: flex; align-items: center; justify-content: center; gap: 0.8rem;
    }
    .ls-eyebrow::before, .ls-eyebrow::after {
        content: ''; display: block; width: 24px; height: 0.5px; background: #9C7D4E;
    }
    .ls-hero-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: clamp(3rem, 7vw, 5.5rem);
        font-weight: 300;
        color: #F7F5F2;
        letter-spacing: 0.02em;
        line-height: 1.05;
        margin-bottom: 1.2rem;
    }
    .ls-hero-title em { font-style: italic; color: #C4985E; }
    .ls-hero-sub {
        font-size: 0.95rem;
        color: #6B6560;
        max-width: 420px;
        margin: 0 auto 2.2rem;
        line-height: 1.75;
        font-weight: 300;
    }
    .ls-hero-actions { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

    .ls-btn-gold {
        font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
        background: #9C7D4E; color: #1C1A17;
        border: none; padding: 0.9rem 2.2rem; border-radius: 1px;
        font-family: 'DM Sans', system-ui, sans-serif;
        text-decoration: none; display: inline-block;
        transition: background 0.2s;
    }
    .ls-btn-gold:hover { background: #C4985E; color: #1C1A17; }

    .ls-btn-outline {
        font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
        background: transparent; color: #F7F5F2;
        border: 0.5px solid rgba(255,255,255,0.25);
        padding: 0.9rem 2.2rem; border-radius: 1px;
        font-family: 'DM Sans', system-ui, sans-serif;
        text-decoration: none; display: inline-block;
        transition: border-color 0.2s, color 0.2s;
    }
    .ls-btn-outline:hover { border-color: #9C7D4E; color: #C4985E; }

    .ls-stats {
        background: #fff;
        border-top: 0.5px solid #E8E4DE;
        border-bottom: 0.5px solid #E8E4DE;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }
    .ls-stat {
        padding: 2.2rem 1.5rem;
        text-align: center;
        border-right: 0.5px solid #E8E4DE;
    }
    .ls-stat:last-child { border-right: none; }
    .ls-stat-num {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 2.4rem; font-weight: 300;
        color: #1C1A17; line-height: 1;
        margin-bottom: 0.35rem;
    }
    .ls-stat-label {
        font-size: 0.65rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #9C9187;
    }
    .ls-stat-accent {
        display: block; width: 16px; height: 1.5px;
        background: #9C7D4E; margin: 0.6rem auto 0;
    }

    .ls-services { padding: 5rem 3rem; background: #F7F5F2; }
    .ls-section-head { text-align: center; margin-bottom: 2.8rem; }
    .ls-section-tag {
        font-size: 0.62rem; letter-spacing: 0.2em;
        text-transform: uppercase; color: #9C7D4E;
        margin-bottom: 0.75rem;
    }
    .ls-section-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 2rem; font-weight: 300; color: #1C1A17;
    }
    .ls-section-title em { font-style: italic; color: #9C7D4E; }
    .ls-section-sub { font-size: 0.85rem; color: #9C9187; margin-top: 0.5rem; font-weight: 300; }

    .ls-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: #DDD9D2;
        border: 0.5px solid #DDD9D2;
        max-width: 960px;
        margin: 0 auto;
    }
    .ls-card { background: #fff; padding: 2.2rem 2rem; transition: background 0.2s; }
    .ls-card:hover { background: #FAFAF8; }
    .ls-card-num {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 2.8rem; font-weight: 300;
        color: #E8E4DE; line-height: 1; margin-bottom: 1rem;
    }
    .ls-card-title { font-size: 0.88rem; font-weight: 500; color: #1C1A17; margin-bottom: 0.6rem; }
    .ls-card-text { font-size: 0.82rem; color: #9C9187; line-height: 1.75; font-weight: 300; }

    .ls-steps { padding: 5rem 3rem; background: #1C1A17; }
    .ls-steps-grid {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 1px; background: rgba(184,149,90,0.2);
        max-width: 960px; margin: 0 auto;
    }
    .ls-step { background: #1C1A17; padding: 2.2rem 2rem; text-align: center; }
    .ls-step-circle {
        width: 44px; height: 44px;
        border: 0.5px solid #9C7D4E; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.2rem;
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 1.2rem; font-weight: 300; color: #9C7D4E;
    }
    .ls-step-title { font-size: 0.85rem; font-weight: 500; color: #F7F5F2; margin-bottom: 0.5rem; }
    .ls-step-text { font-size: 0.78rem; color: #6B6560; line-height: 1.75; font-weight: 300; }

    .ls-cta {
        padding: 5rem 2rem; background: #F7F5F2;
        text-align: center; border-top: 0.5px solid #DDD9D2;
    }
    .ls-cta-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 2.2rem; font-weight: 300; color: #1C1A17;
        margin-bottom: 0.75rem;
    }
    .ls-cta-title em { font-style: italic; color: #9C7D4E; }
    .ls-cta-sub { font-size: 0.88rem; color: #9C9187; margin-bottom: 2rem; font-weight: 300; }
    .ls-cta-actions { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

    .ls-btn-dark {
        font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
        background: #1C1A17; color: #F7F5F2;
        border: none; padding: 0.9rem 2.4rem; border-radius: 1px;
        font-family: 'DM Sans', system-ui, sans-serif;
        text-decoration: none; display: inline-block;
        transition: background 0.2s;
    }
    .ls-btn-dark:hover { background: #9C7D4E; color: #1C1A17; }

    .ls-btn-border {
        font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
        background: transparent; color: #1C1A17;
        border: 0.5px solid #1C1A17;
        padding: 0.9rem 2.4rem; border-radius: 1px;
        font-family: 'DM Sans', system-ui, sans-serif;
        text-decoration: none; display: inline-block;
        transition: border-color 0.2s, color 0.2s;
    }
    .ls-btn-border:hover { border-color: #9C7D4E; color: #9C7D4E; }

    @@media (max-width: 768px) {
        .ls-stats { grid-template-columns: repeat(2, 1fr); }
        .ls-stat { border-bottom: 0.5px solid #E8E4DE; }
        .ls-cards, .ls-steps-grid { grid-template-columns: 1fr; }
        .ls-services, .ls-steps { padding: 3rem 1.5rem; }
    }
</style>
}