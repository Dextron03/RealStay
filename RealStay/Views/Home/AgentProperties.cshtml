@model List<Application.ViewModels.Properties.PropertyViewModel>
@{
    ViewData["Title"] = "Propiedades de " + ViewData["AgentName"];
}

<div class="ap-root">
    <div class="ap-page-head">
        <div>
            <div class="ap-eyebrow">Portafolio del agente</div>
            <div class="ap-page-title">@ViewData["AgentName"]</div>
        </div>
        <a asp-action="Agents" class="ap-btn ap-btn-border">← Volver a agentes</a>
    </div>

    @if (Model.Any())
    {
        <div class="ap-grid">
            @foreach (var item in Model)
            {
                <div class="ap-card">
                    <div class="ap-card-img">
                        @if (item.ImageUrls.Any())
                        {
                            <img src="@item.ImageUrls.First()" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="ap-card-img-empty">
                                <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                                    <path d="M2 14V7L8 2l6 5v7H10v-4H6v4H2z" stroke="#9C7D4E" stroke-width="0.8"/>
                                </svg>
                            </div>
                        }
                        <span class="ap-card-type">@item.PropertyTypeName</span>
                        <span class="ap-card-sale">@item.TypeSaleName</span>
                    </div>
                    <div class="ap-card-body">
                        <div class="ap-card-name">@item.Name</div>
                        <div class="ap-card-loc">@item.Location</div>
                        <div class="ap-card-price">RD$ @item.Price.ToString("N0") <span>DOP</span></div>
                    </div>
                    <div class="ap-card-footer">
                        <div class="ap-meta">
                            <div class="ap-meta-item"><div class="ap-dot"></div>@item.Rooms hab.</div>
                            <div class="ap-meta-item"><div class="ap-dot"></div>@item.Bathrooms baños</div>
                            <div class="ap-meta-item"><div class="ap-dot"></div>@item.Meters m²</div>
                        </div>
                        <a asp-action="PropertyDetails" asp-route-id="@item.Id" class="ap-detail-link">Ver →</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ap-empty">
            <div class="ap-empty-title">Sin propiedades</div>
            <div class="ap-empty-sub">Este agente aún no tiene propiedades disponibles.</div>
        </div>
    }
</div>

@section Scripts {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@@0,300;0,400;1,300&family=DM+Sans:wght@@300;400;500&display=swap');
    .ap-root { font-family:'DM Sans',system-ui,sans-serif; background:#F7F5F2; padding:2rem 2.5rem; }
    .ap-page-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; padding-bottom:1.25rem; border-bottom:0.5px solid #DDD9D2; }
    .ap-eyebrow { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:#9C7D4E; margin-bottom:0.35rem; }
    .ap-page-title { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.8rem; font-weight:300; color:#1C1A17; }
    .ap-btn { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; padding:0.62rem 1.25rem; border:none; border-radius:0; cursor:pointer; font-family:'DM Sans',system-ui,sans-serif; text-decoration:none; display:inline-block; transition:background 0.2s,color 0.2s,border-color 0.2s; }
    .ap-btn-border { background:transparent; color:#6B6560; border:0.5px solid #D4CFC8; } .ap-btn-border:hover { border-color:#9C7D4E; color:#9C7D4E; }
    .ap-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:#DDD9D2; border:0.5px solid #DDD9D2; }
    .ap-card { background:#fff; display:flex; flex-direction:column; transition:background 0.15s; }
    .ap-card:hover { background:#FAFAF8; }
    .ap-card-img { height:200px; position:relative; overflow:hidden; background:#E8E4DE; }
    .ap-card-img img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.4s; }
    .ap-card:hover .ap-card-img img { transform:scale(1.03); }
    .ap-card-img-empty { width:100%; height:100%; background:#EAE7E2; display:flex; align-items:center; justify-content:center; }
    .ap-card-type { position:absolute; top:10px; left:10px; font-size:0.56rem; letter-spacing:0.12em; text-transform:uppercase; background:#9C7D4E; color:#1C1A17; padding:3px 8px; }
    .ap-card-sale { position:absolute; top:10px; right:10px; font-size:0.56rem; letter-spacing:0.12em; text-transform:uppercase; background:#1C1A17; color:#F7F5F2; padding:3px 8px; }
    .ap-card-body { padding:1.1rem 1.1rem 0.7rem; flex:1; }
    .ap-card-name { font-size:0.9rem; font-weight:500; color:#1C1A17; margin-bottom:0.3rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ap-card-loc { font-size:0.72rem; color:#9C9187; margin-bottom:0.7rem; }
    .ap-card-price { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.45rem; font-weight:300; color:#1C1A17; line-height:1; }
    .ap-card-price span { font-size:0.68rem; font-family:'DM Sans',system-ui,sans-serif; color:#9C9187; margin-left:3px; }
    .ap-card-footer { padding:0.75rem 1.1rem; border-top:0.5px solid #E8E4DE; display:flex; justify-content:space-between; align-items:center; }
    .ap-meta { display:flex; gap:0.85rem; }
    .ap-meta-item { font-size:0.68rem; color:#9C9187; display:flex; align-items:center; gap:4px; }
    .ap-dot { width:3px; height:3px; background:#9C7D4E; border-radius:50%; flex-shrink:0; }
    .ap-detail-link { font-size:0.62rem; letter-spacing:0.12em; text-transform:uppercase; color:#9C7D4E; text-decoration:none; border-bottom:0.5px solid transparent; transition:border-color 0.2s; }
    .ap-detail-link:hover { border-color:#9C7D4E; }
    .ap-empty { text-align:center; padding:5rem 2rem; background:#fff; border:0.5px solid #DDD9D2; }
    .ap-empty-title { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.8rem; font-weight:300; color:#1C1A17; margin-bottom:0.5rem; }
    .ap-empty-sub { font-size:0.82rem; color:#9C9187; font-weight:300; }
    @@media (max-width:900px) { .ap-grid { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:580px) { .ap-grid { grid-template-columns:1fr; } .ap-root { padding:1.5rem 1rem; } }
</style>
}